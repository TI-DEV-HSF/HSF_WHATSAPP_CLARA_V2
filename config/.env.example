# ==========================================
# CLARA V2 - Configuração de Ambiente
# ==========================================
# COPIE este arquivo para .env e preencha com seus valores
# NUNCA commite .env no repositório Git!
#
# Comando: cp config/.env.example .env
# ==========================================

# --- BANCO DE DADOS ORACLE (TASY) ---
TASY_USER=TASY
TASY_PASSWORD=sua_senha_aqui_super_segura
TASY_DSN=192.168.5.9:1521/TASYPRD
ORACLE_CLIENT_PATH=instantclient-basiclite-windows.x64-23.6.0.24.10/instantclient_23_6

# --- WHATSAPP ---
# Opção 1: WhatsApp Web (RPA - não recomendado)
WHATSAPP_WEB_PROFILE=profile/wpp

# Opção 2: WhatsApp Business API (recomendado)
WHATSAPP_BUSINESS_API_URL=https://api.whatsapp.com/v15.0
WHATSAPP_BUSINESS_PHONE_ID=seu_phone_id_aqui
WHATSAPP_BUSINESS_API_TOKEN=seu_token_aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_account_id

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FILE=logs/clara.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# --- NOTIFICAÇÕES ---
# Slack (opcional - para alertas)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#clara-alertas

# Email (opcional - para relatórios)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=clara-hsf@hospitalfrancisco.com.br
EMAIL_TO=administrador@hospitalfrancisco.com.br

# --- GOOGLE SHEETS (para auditoria) ---
GOOGLE_SHEETS_CREDENTIALS_PATH=config/google-credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=seu_spreadsheet_id

# --- N8N (se usar) ---
N8N_URL=https://n8n.hospitalfrancisco.com.br
N8N_API_KEY=seu_n8n_api_key

# --- APLICAÇÃO ---
ENVIRONMENT=development  # development, staging, production
DEBUG=true
TIMEZONE=America/Sao_Paulo
LANGUAGE=pt-BR

# --- VALIDAÇÃO ---
# Habilitar validações rigorosas
VALIDATE_PHONE=true
VALIDATE_EMAIL=true
VALIDATE_CPF=true

# --- LIMITES ---
MAX_RETRIES=3
TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=5

# --- CACHE ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ==========================================
# NÃO ALTERE ABAIXO (padrões do sistema)
# ==========================================
APP_NAME=CLARA
APP_VERSION=2.0
RELEASE_DATE=2026-09-30
