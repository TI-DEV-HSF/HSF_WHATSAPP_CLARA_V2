# CLARA v2 - copie para config/.env e preencha. Nunca commite o .env.

# --- TASY (Oracle) ---
# O Oracle Instant Client é carregado da pasta instantclient_23_6/ na raiz do projeto
TASY_USER=TASY
TASY_PASSWORD=sua_senha_aqui
TASY_DSN=192.168.5.9:1521/TASYPRD

# --- Evolution API (WhatsApp sem navegador) ---
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=chave_AUTHENTICATION_API_KEY_da_evolution
EVOLUTION_INSTANCE=clara_teste
# Intervalo aleatório entre envios (reduz risco de bloqueio do número)
INTERVALO_MIN_S=8
INTERVALO_MAX_S=20

# --- Receptor de respostas (webhook) ---
# A Evolution chama http://host.docker.internal:WEBHOOK_PORTA/webhook/evolution
# Em produção, defina WEBHOOK_URL_EVOLUTION com o IP do servidor do CLARA
WEBHOOK_PORTA=8765
WEBHOOK_TOKEN=gere_um_texto_aleatorio_longo

# --- Modo teste ---
# true (padrão): envia SOMENTE para TELEFONE_TESTE, no máximo LIMITE_TESTE mensagens,
# e NÃO grava nada no TASY. Produção só com MODO_TESTE=false.
MODO_TESTE=true
TELEFONE_TESTE=55DDD9XXXXXXXX
LIMITE_TESTE=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=C:\Projetos\HSF\HSF_WHATSAPP_CLARA_V2\logs
